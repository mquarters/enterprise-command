{
  "name": "@platform/ui-sdk",
  "version": "1.0.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "style": "src/tokens/variables.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens": "./src/tokens/variables.css",
    "./tokens/tailwind": "./src/tokens/tailwind.config.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "dev": "vite"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}